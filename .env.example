# =====================================================================
#  MBG-BIOLOOP AI: daftar pengaturan
#
#  DI VERCEL  : isi nama & nilai di bawah lewat Project → Settings → Environment Variables.
#               File .env TIDAK dipakai di Vercel.
#  DI LAPTOP  : salin file ini menjadi ".env" lalu isi.
#
#  JANGAN pernah mengunggah file .env atau membagikan token/kunci ke siapa pun.
# =====================================================================

# ---------- Wajib di Vercel ----------
# Alamat database PostgreSQL.
#  - Supabase: Project → tombol "Connect" → "Transaction pooler" (port 6543), ganti [YOUR-PASSWORD]
#  - Neon (Vercel → Storage → Create → Neon): terisi otomatis sebagai DATABASE_URL
# Integrasi Supabase dari Vercel Marketplace mengisi POSTGRES_URL; itu juga dikenali otomatis.
# Kosongkan di laptop untuk memakai penyimpanan berkas (folder data/).
DATABASE_URL=

# ---------- Asisten AI (Gemini) ----------
# Buat API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Izinkan asisten menjalankan aksi (buffer, kompor, katup) bila diminta pengguna yang sudah masuk
AI_CAN_CONTROL=true

# ---------- Telegram ----------
# Token dari @BotFather (format 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=
# Chat baru harus disetujui admin di panel (sangat disarankan: true)
TELEGRAM_REQUIRE_APPROVAL=true
# Chat ID yang otomatis disetujui (opsional, pisahkan koma). Ketik /id di bot untuk melihatnya.
TELEGRAM_ALLOWED_CHAT_IDS=
# auto = webhook di Vercel, long polling di laptop
TELEGRAM_MODE=auto
# Jenis notifikasi otomatis
NOTIFY_ALERTS=true
NOTIFY_ACTIONS=true
NOTIFY_SCHEDULE=false
ALERT_COOLDOWN_MIN=15

# ---------- Akun admin pertama ----------
# Dibuat otomatis hanya bila belum ada admin. Setelah masuk, SEGERA ganti kata sandinya di panel admin.
ADMIN_USERNAME=Handoyo
ADMIN_PASSWORD=12345

# ---------- Keamanan (opsional) ----------
# Kunci penanda sesi masuk. Bila kosong, diturunkan dari DATABASE_URL.
# Buat acak misalnya dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Bila diisi, /api/cron hanya bisa dipanggil dengan "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron mengirim header ini otomatis; isi juga secret CRON_SECRET di GitHub Actions)
CRON_SECRET=

# ---------- Umum ----------
SITE_NAME=SPPG Contoh
# Kecepatan simulasi: 1 = waktu nyata, 60 = 1 menit per detik, 600 = 10 menit per detik
SIM_SPEED=60
# Nilai awal (bisa diubah admin di panel → Pengaturan)
ALLOW_REGISTER=true
PUBLIC_DASHBOARD=true
REPORT_EVERY_HOURS=12
RETENTION_DAYS=90
REPORT_TIMEZONE=Asia/Jakarta

# ---------- Hanya untuk server lokal ----------
PORT=3000
HOST=0.0.0.0
DATA_DIR=data
# Alamat publik website (untuk webhook Telegram). Di Vercel terisi otomatis.
PUBLIC_URL=
